{
  "name": "cine-local",
  "version": "1.1.0",
  "description": "Catálogo e player de filmes locais, com compressão e download do Telegram",
  "main": "public/js/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node public/js/server.js",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "big-integer": "^1.6.52",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "telegram": "^2.26.22"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Cine Local",
  "author": "Natz",
  "build": {
    "appId": "com.natz.cinelocal",
    "productName": "Cine Local",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!filmes/**",
      "!.cache/**",
      "!config.json",
      "!telegram.session",
      "!window.json",
      "!dist/**",
      "!iniciar.bat",
      "!README.md",
      "!**/*.part",
      "!**/*.part.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cine Local",
      "artifactName": "CineLocal-Setup-${version}.exe"
    },
    "npmRebuild": false
  }
}
